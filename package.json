{
  "name": "inkline",
  "version": "1.0.0",
  "private": true,
  "description": "Engraved 3D launch films with their own storyboard, built per script: a director's skill, a subject builder, an original score and foley, render and motion QA. Built with Remotion and Three.js.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "selftest": "bash tools/selftest.sh",
    "plan": "python3 -I tools/plan.py",
    "stills": "bash tools/stills.sh",
    "render": "bash tools/render.sh",
    "showcase": "python3 -I tools/showcase.py",
    "qa": "python3 -I tools/motion_qa.py",
    "check": "python3 -I tools/film.py",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/three": "4.0.534",
    "bezier-js": "^6.1.4",
    "culori": "^4.0.2",
    "d3-contour": "^4.0.2",
    "d3-shape": "^3.2.0",
    "flubber": "^0.4.2",
    "opentype.js": "^2.0.0",
    "p5.brush": "^2.2.3",
    "perfect-freehand": "^1.2.3",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "roughjs": "^4.6.6",
    "simplex-noise": "^4.0.3",
    "svg-path-properties": "^2.1.0",
    "three": "0.178.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/bezier-js": "^4.1.3",
    "@types/culori": "^4.0.1",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-shape": "^3.2.0",
    "@types/flubber": "^0.4.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.178.1",
    "@types/topojson-client": "3.1.5",
    "typescript": "5.9.3"
  }
}
